# URL pública del proyecto Supabase (Sacha Wasi)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública anon/publishable (segura en el navegador con RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Alias opcional
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor / migraciones. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Sin estas variables públicas la app corre en modo DEMO local.
