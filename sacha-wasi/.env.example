# URL pública del proyecto Supabase (Sacha Wasi)
NEXT_PUBLIC_SUPABASE_URL=https://jmpebicnieuvmjpfjyud.supabase.co

# Clave pública anon/publishable (Project Settings → API en Supabase)
# Es segura para el navegador cuando las políticas RLS están habilitadas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Alias opcional
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor / migraciones. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.jmpebicnieuvmjpfjyud.supabase.co:5432/postgres

# Sin NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY la app corre en modo DEMO local.
