# URL pública del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Clave pública "anon" o "publishable" de Supabase. Es segura para el navegador
# cuando las políticas RLS están habilitadas.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Solo para ejecutar migraciones desde herramientas administrativas.
# Nunca debe exponerse con el prefijo NEXT_PUBLIC_ ni utilizarse en el cliente.
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
